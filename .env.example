NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/project-camp
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
REFRESH_TOKEN_EXPIRY=7d
SERVER_URL=http://localhost:3000
# Comma-separated frontend origins, if a frontend is added
CORS_ORIGIN=http://localhost:5173

# Optional email configuration
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your-user
MAILTRAP_SMTP_PASS=your-password
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password
